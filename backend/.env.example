APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production (as of 26.09.18): Bluehost's own authenticated SMTP, sending
# as min@one-organic.com — a known-working mailbox, not a new one. Only
# move to a paid provider (Resend, then Postmark) if a real deliverability
# test (php artisan mail:test <address>, checked inbox vs. spam at Gmail
# and Outlook) shows a problem — see Phase 0.5.4 of the implementation
# plan. Get the exact host/port/scheme from cPanel > Email Accounts >
# min@one-organic.com > Connect Devices, not a guess — settings can vary
# by server. Never commit the real password here.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where the public Contact form's messages are delivered — override only
# if that should differ from the hello@one-organic.com default baked into
# config/mail.php's 'contact_recipient'.
MAIL_CONTACT_RECIPIENT=hello@one-organic.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated frontend origins allowed to call the API (see config/cors.php).
# Never a wildcard. Production value (as of 26.09.17):
# https://one-organic-site.vercel.app,https://one-organic.com,https://www.one-organic.com
CORS_ALLOWED_ORIGINS=http://localhost:5183,http://localhost:5173,http://127.0.0.1:5183

# Xendit payment gateway. Use a "xnd_development_..." secret key for sandbox.
# Webhook verification token comes from the Xendit dashboard's Webhooks settings.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_VERIFICATION_TOKEN=
XENDIT_IS_PRODUCTION=false

# The frontend's public URL — Xendit Card Sessions require an HTTPS origin,
# so local dev needs an https tunnel (e.g. `ngrok http 5173`) here, not
# http://localhost.
FRONTEND_URL=https://one-organic-site.vercel.app

# SHIPPOP courier rate lookup/booking (Phase 1.1), KEX as primary carrier.
# Sandbox base URL: https://mkpservice.shippop.dev
# Production base URL: https://mkpservice.shippop.com (from SHIPPOP's sales
# team after account review — sandbox key is auto-issued on signup).
SHIPPOP_BASE_URL=
SHIPPOP_API_KEY=
SHIPPOP_MARKET_ID=

# Unguessable path segment for the /webhooks/shippop/{token} endpoint — see
# ShippopWebhookController. Generate with `php artisan tinker --execute="echo
# Str::random(40);"` and give SHIPPOP's dev team the resulting full URL when
# registering it (contacting them is required either way — no self-service
# webhook setup exists as of 26.09.19).
SHIPPOP_WEBHOOK_TOKEN=

# Value SHIPPOP's dev team sends back on every webhook call as the
# X-Webhook-Secret header (confirmed configured on their end 26.09.21).
# Checked in addition to SHIPPOP_WEBHOOK_TOKEN above, not instead of it.
SHIPPOP_WEBHOOK_SECRET=

# Ship-from contact phone (see config/shipping.php) — the address itself is
# taken from a real past shipping label, but no phone was printed on it.
SHIPPING_ORIGIN_PHONE=

# Sentry error monitoring (Phase 1.6). Leave blank to disable reporting
# entirely (e.g. local dev) — the SDK no-ops with no DSN set.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
