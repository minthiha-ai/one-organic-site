VITE_API_URL=http://one-organic-backend.test/api

# Sentry error monitoring (Phase 1.6). Leave blank to disable reporting
# entirely (e.g. local dev) — Sentry.init() below no-ops with no DSN set.
VITE_SENTRY_DSN=

# General Shopee shop URL — fallback "Buy on Shopee" link on the product
# page when neither the product nor the selected variant has its own
# shopee_url set in the admin. Leave blank to show "Currently unavailable"
# instead of a dead link until Shopee links are filled in.
VITE_SHOPEE_STORE_URL=
